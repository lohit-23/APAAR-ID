# ShikshaSetu AI - Backend Configuration (.env)
# Prototype for Smart India Hackathon
# Replace with your Supabase project credentials if connecting to live Supabase

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Environment & Server Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
